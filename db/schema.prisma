// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TokenType {
  RESET_PASSWORD
}

enum PaperStatus {
  PENDING_REVIEW
  PENDING_PDF
  ACCEPTED
  EXCLUDED
  ADDED_TO_TRAINING
}

enum DiscoverySource {
  DIRECT
  CITED
}

model User {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  name           String?
  institution    String?
  email          String   @unique
  hashedPassword String?
  role           Role     @default(USER)
  groqApiKey     String?

  tokens         Token[]
  sessions       Session[]
  papersReviewed Paper[]
  favorites        UserFavorite[]
  datasetFavorites UserDatasetFavorite[]
  reports          PaperReport[]
  metadataEdits    MetadataEditSuggestion[]
  extractionEdits  ExtractionEditSuggestion[]
  pipelineRuns        PipelineRun[]
  extractionsVerified PaperExtraction[]
  articleSuggestions  ArticleSuggestion[]
}

model Session {
  id                 Int       @id @default(autoincrement())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime?
  handle             String    @unique
  hashedSessionToken String?
  antiCSRFToken      String?
  publicData         String?
  privateData        String?

  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}

model Paper {
  id               Int               @id @default(autoincrement())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  title            String
  authors          String[]
  year             Int?
  doi              String?           @unique
  openAlexId       String?           @unique
  abstract         String?
  journal          String?
  pdfUrl           String?
  modelScore       Float?
  status           PaperStatus       @default(PENDING_REVIEW)
  reviewNote       String?
  isValidation     Boolean           @default(false)
  reviewedBy       User?             @relation(fields: [reviewedById], references: [id])
  reviewedById     Int?
  canonicalPaperId    Int?
  canonical           Paper?            @relation("duplicates", fields: [canonicalPaperId], references: [id])
  duplicates          Paper[]           @relation("duplicates")
  discoverySource     DiscoverySource   @default(DIRECT)
  citationsFetchedAt  DateTime?
  authorMeta          Json?
  extraction       PaperExtraction?
  favorites        UserFavorite[]
  reports          PaperReport[]
  metadataEdits    MetadataEditSuggestion[]
  extractionEdits  ExtractionEditSuggestion[]
  citationsFrom    PaperCitation[]
  datasetLinks     DatasetLink[]
}


model PaperCitation {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now())
  citingPaperId   Int
  citingPaper     Paper    @relation(fields: [citingPaperId], references: [id], onDelete: Cascade)
  citedOpenAlexId String
  title           String?
  authors         String[]
  year            Int?
  journal         String?
  reviewed        Boolean  @default(false)

  @@unique([citingPaperId, citedOpenAlexId])
}

model UserFavorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int
  paperId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
}

model UserDatasetFavorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int
  bibtex    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bibtex])
}

model PaperReport {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  paperId   Int
  userId    Int
  reason    String
  note      String?
  resolved  Boolean  @default(false)

  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
}

model MetadataEditSuggestion {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  paperId   Int
  userId    Int
  title     String?
  authors   String[]
  year      Int?
  doi       String?
  journal   String?
  abstract  String?
  note      String?
  resolved  Boolean  @default(false)

  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
}

model ExtractionEditSuggestion {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  paperId          Int
  userId           Int
  language         String[]
  participantCount Int?
  participantType  String?
  stimuliType      String[]
  stimuliCount     Int?
  normsCollected   String[]
  instructions     String?
  url              String?
  note             String?
  resolved         Boolean  @default(false)

  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
}

model PaperExtraction {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  paperId          Int      @unique
  paper            Paper    @relation(fields: [paperId], references: [id])
  language         String[]
  participantCount Int?
  participantType  String?
  stimuliType      String[]
  stimuliCount     Int?
  normsCollected   String[]
  instructions     String?
  licenseUrl       String?
  dataSource       String?
  participantLevelData Boolean  @default(false)
  reliabilities        Json?
  confidence           Float?
  needsReview          Boolean   @default(false)
  extractedBy      String?
  extractedAt      DateTime
  verifiedAt       DateTime?
  verifiedById     Int?
  verifiedBy       User?     @relation(fields: [verifiedById], references: [id])
}

model ModelRun {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  trainSize      Int
  valSize        Int
  accuracy       Float
  precision      Float
  recall         Float
  f1             Float
  valRebalanced  Boolean  @default(false)
  notes          String?
}

enum PipelineStatus {
  RUNNING
  DONE
  FAILED
}

model PipelineRun {
  id          Int            @id @default(autoincrement())
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?
  status      PipelineStatus @default(RUNNING)
  step        String?
  output      String?
  startedById Int?
  startedBy   User?          @relation(fields: [startedById], references: [id])
}

model ArticleSuggestion {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  userId    Int
  title     String?
  authors   String?
  year      Int?
  doi       String?
  url       String?
  note      String?
  resolved  Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Token {
  id          Int       @id @default(autoincrement())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hashedToken String
  type        TokenType
  expiresAt   DateTime
  sentTo      String

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([hashedToken, type])
}

model DatasetLink {
  bibtex    String   @id
  paperId   Int
  createdAt DateTime @default(now())
  paper     Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
}

model DuplicateGroupIgnore {
  id        Int      @id @default(autoincrement())
  groupKey  String
  groupType String
  label     String
  createdAt DateTime @default(now())

  @@unique([groupKey, groupType])
}

model SiteSettings {
  id              Int      @id @default(1)
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}
